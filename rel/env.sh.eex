ip=$(getent hosts fly-local-6pn 2>/dev/null | awk 'NR == 1 {print $1}')

if [ -n "${FLY_APP_NAME:-}" ] && [ -n "${ip:-}" ]; then
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="$FLY_APP_NAME@$ip"
  export LIVE_BEATS_SERVER_IP="$ip"
else
  echo "release: Fly clustering disabled; fly-local-6pn or FLY_APP_NAME is unavailable" >&2
  unset RELEASE_DISTRIBUTION RELEASE_NODE LIVE_BEATS_SERVER_IP
fi
