<main class="">
  {@inner_content}
</main>

<% flashes = [
  %{
    key: :success,
    title: "Success!"
  },
  %{
    key: :info,
    title: "Information"
  },
  %{
    key: :error,
    title: "Error!"
  }
] %>

<%= for flash <- flashes do %>
  <%= if message = Phoenix.Flash.get(@flash, flash.key) do %>
    <div
      aria-live="assertive"
      class="pointer-events-none fixed inset-0 flex items-end px-4 py-6 sm:items-start sm:p-6"
    >
      <div class="flex w-full flex-col items-center space-y-4 sm:items-end">
        <div
          phx-click="lv:clear-flash"
          phx-value-key={flash.key}
          class="pointer-events-auto w-full max-w-sm overflow-hidden rounded-lg bg-white shadow-lg ring-1 ring-black ring-opacity-5 cursor-pointer"
        >
          <div class="p-4">
            <div class="flex items-start">
              <div class="flex-shrink-0"></div>
              <div class="ml-3 w-0 flex-1 pt-0.5">
                <p class="text-sm font-medium text-gray-900">{flash.title}</p>
                <p class="mt-1 text-sm text-gray-500">{message}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
