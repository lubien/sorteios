<SorteiosWeb.Components.two_columns_layout>
  <div class="overflow-hidden bg-white shadow sm:rounded-md">
    <ul role="list" class="divide-y divide-gray-200">
      <%= if Enum.empty?(@prizes) do %>
        <div class="relative block w-full rounded-lg border-2 border-dashed border-gray-300 p-12 text-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="mx-auto h-12 w-12 text-gray-400"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"
            />
          </svg>

          <%= if @admin? do %>
            <button
              phx-click="quick_add_prize"
              class="mt-4 inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 text-sm"
            >
              Add prize
            </button>
          <% else %>
            <span class="mt-2 block text-sm font-medium text-gray-900">
              Wait for the admin to create a prize
            </span>
          <% end %>
        </div>
      <% end %>

      <%= if not Enum.empty?(@prizes) && @admin? do %>
        <div class="flex justify-end px-4 py-3">
          <button
            phx-click="quick_add_prize"
            class="inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 text-sm"
          >
            + Add prize
          </button>
        </div>
      <% end %>

      <%= for prize <- @prizes do %>
        <li class="px-4 py-4 sm:px-6">
          <div class="flex items-center justify-between gap-3">
            <%!-- Avatar --%>
            <div class="flex-shrink-0">
              <%= if prize.winner_name do %>
                <img
                  class="h-10 w-10 rounded-full"
                  src={gravatar(prize.winner_email || "")}
                  alt=""
                />
              <% else %>
                <div class="h-10 w-10 rounded-full bg-gray-200 border-2 border-gray-400 border-dotted">
                </div>
              <% end %>
            </div>

            <%!-- Name + winner info --%>
            <div class="min-w-0 flex-1">
              <%= if @admin? && prize.winner_name == nil do %>
                <%= if @editing_prize_id == prize.id do %>
                  <input
                    type="text"
                    value={prize.name}
                    phx-mounted={JS.focus()}
                    phx-blur="save_prize_name"
                    phx-value-prize-id={prize.id}
                    phx-key="Escape"
                    phx-keydown="cancel_edit_prize"
                    class="w-full rounded border-indigo-300 text-sm font-semibold text-indigo-600 focus:border-indigo-500 focus:ring-indigo-500"
                  />
                <% else %>
                  <button
                    phx-click="start_edit_prize"
                    phx-value-prize-id={prize.id}
                    class="group flex items-center gap-1 text-left max-w-full"
                  >
                    <span class="truncate text-sm font-semibold text-indigo-600">
                      {prize.name}
                    </span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-3.5 w-3.5 flex-shrink-0 text-gray-300 group-hover:text-indigo-400"
                    >
                      <path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" />
                    </svg>
                  </button>
                <% end %>
              <% else %>
                <p class="truncate text-sm font-semibold text-indigo-600">{prize.name}</p>
              <% end %>

              <%= if prize.winner_name do %>
                <p class="mt-1 flex items-center gap-1 text-sm text-gray-500">
                  <svg
                    class="h-4 w-4 flex-shrink-0 text-green-400"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span class="truncate">{prize.winner_name}</span>
                </p>
                <%= if prize.winner_email != nil and @admin? do %>
                  <p class="mt-0.5 flex items-center gap-1 text-xs text-gray-400">
                    <svg
                      class="h-4 w-4 flex-shrink-0"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z" />
                      <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z" />
                    </svg>
                    <span class="truncate">{prize.winner_email}</span>
                  </p>
                <% end %>
              <% else %>
                <p class="mt-1 text-xs text-gray-400">No winner yet</p>
              <% end %>
            </div>

            <%!-- Admin actions: draw + delete (unclaimed prizes only) --%>
            <%= if @admin? && prize.winner_name == nil do %>
              <div class="flex flex-shrink-0 items-center gap-1">
                <%!-- Draw button / loading indicator --%>
                <%= cond do %>
                  <% @drawing_prize_id == prize.id && @loading_winner? -> %>
                    <span class="animate-pulse text-xs font-medium text-indigo-400">
                      Drawing…
                    </span>
                    <button
                      phx-click="cancel_draw"
                      class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-400"
                      aria-label="Cancel draw"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        class="h-4 w-4"
                      >
                        <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
                      </svg>
                    </button>
                  <% is_nil(@drawing_prize_id) -> %>
                    <button
                      phx-click="draw_prize"
                      phx-value-prize-id={prize.id}
                      class="inline-flex items-center gap-1 rounded-md bg-indigo-50 px-2.5 py-1.5 text-xs font-medium text-indigo-600 hover:bg-indigo-100 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        class="h-3.5 w-3.5"
                      >
                        <path d="M10 3.75a2 2 0 10-4 0 2 2 0 004 0zM17.25 4.5a.75.75 0 000-1.5h-5.5a.75.75 0 000 1.5h5.5zM5 3.75a.75.75 0 01-.75.75h-1.5a.75.75 0 010-1.5h1.5a.75.75 0 01.75.75zM4.25 17a.75.75 0 000-1.5h-1.5a.75.75 0 000 1.5h1.5zM17.25 17a.75.75 0 000-1.5h-5.5a.75.75 0 000 1.5h5.5zM9 10a.75.75 0 01-.75.75h-5.5a.75.75 0 010-1.5h5.5A.75.75 0 019 10zM17.25 10.75a.75.75 0 000-1.5h-1.5a.75.75 0 000 1.5h1.5zM14 10a2 2 0 10-4 0 2 2 0 004 0zM10 16.25a2 2 0 10-4 0 2 2 0 004 0z" />
                      </svg>
                      Draw
                    </button>
                  <% true -> %>
                    <%!-- Another prize is being drawn — no button shown --%>
                <% end %>

                <%!-- Delete button --%>
                <button
                  phx-click="remove_prize"
                  phx-value-prize-name={prize.name}
                  data-confirm="Are you sure? This cannot be undone"
                  class="flex-shrink-0 rounded-md p-2 text-gray-400 hover:bg-red-50 hover:text-red-500 focus:outline-none focus:ring-2 focus:ring-red-400"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="h-5 w-5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"
                    />
                  </svg>
                </button>
              </div>
            <% end %>
          </div>

          <%!-- Drawn person: shown inline below the prize row --%>
          <%= if @admin? && @drawing_prize_id == prize.id && @random_person && !@loading_winner? do %>
            <div class="mt-3 flex flex-col gap-3 rounded-lg bg-indigo-50 p-3 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex min-w-0 items-center gap-3">
                <img
                  class="h-9 w-9 flex-shrink-0 rounded-full"
                  src={gravatar(@random_person.email)}
                  alt=""
                />
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-gray-900">
                    {@random_person.name}
                  </p>
                  <p class="truncate text-xs text-gray-500">{@random_person.email}</p>
                </div>
              </div>

              <div class="flex flex-shrink-0 gap-2">
                <button
                  phx-click="draw_prize"
                  phx-value-prize-id={prize.id}
                  class="flex-1 rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 sm:flex-none"
                >
                  Re-draw
                </button>
                <button
                  phx-click="confirm_prize_winner"
                  phx-value-prize-id={prize.id}
                  data-confirm="Are you sure? This cannot be undone"
                  class="flex-1 rounded-md border border-transparent bg-indigo-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 sm:flex-none"
                >
                  Assign
                </button>
              </div>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="border-b border-gray-200 py-5">
    <h3 class="text-lg font-medium leading-6 text-gray-900">Participants</h3>
  </div>

  <div class="mt-6">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <%= for user <- @users do %>
        <.user_block user={user} show_email?={@admin?} />
      <% end %>
    </div>
  </div>
  <:right_side>
    <.user_block user={@current_user} show_email?={true} />
  </:right_side>
  <:right_side>
    <section aria-labelledby="section-2-title">
      <div class="overflow-hidden rounded-lg bg-white shadow">
        <div class="p-6">
          <div class="px-4 pb-5">
            <h3 class="text-lg font-medium leading-6 text-gray-900">Invite people</h3>

            <div class="mt-5 mb-2 sm:flex sm:items-center">
              <div class="w-full sm:max-w-xs">
                <input
                  id="invite-link"
                  type="text"
                  value={Routes.room_show_url(@socket, :show, @id)}
                  class="block w-full rounded-md bg-gray-300 border-gray-400 shadow-sm sm:text-sm"
                />
              </div>

              <button
                id="copy-to-clipboard"
                phx-hook="CopyToClipboard"
                data-input-selector="#invite-link"
                class="mt-3 inline-flex w-full items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm"
              >
                Copy
              </button>
            </div>

            <div class="flex place-content-center">
              <.link href={Routes.export_path(@socket, :create_qr_code, @id)}>
                {{:safe, @invite_image}}
              </.link>
            </div>
          </div>
        </div>
      </div>
    </section>
  </:right_side>
</SorteiosWeb.Components.two_columns_layout>
